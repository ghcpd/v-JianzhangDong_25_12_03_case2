# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real secrets to version control

# Payment Service Token
PAYMENT_TOKEN=your_payment_token_here

# Mail Server API Key
MAIL_SERVER_KEY=your_mail_server_key_here

# Internal Authentication Secret
INTERNAL_AUTH=your_internal_auth_secret_here

# Allowed Domains for SSRF Protection (comma-separated)
ALLOWED_DOMAINS=localhost,127.0.0.1,trusted-domain.com

# Base Directory for Configuration Files
ALLOWED_CONFIG_DIR=./configs

# Flask Debug Mode (True/False) - Should be False in production
FLASK_DEBUG=False
